# Local settings. `just setup` copies this file to .env and fills in the two
# generated secrets. .env is ignored by git; never commit it.

# Admin key of the local LiteLLM proxy. The CLI uses it to create a key with a
# budget for each run.
LITELLM_MASTER_KEY=
# Password of the proxy's Postgres database; letters and digits only, as it is
# part of a URL. Postgres keeps the password it was created with: after you
# change it, remove the stack's volume (`docker compose -p <project> down -v`).
POSTGRES_PASSWORD=

# Keys of the model providers you use. models/*.yaml refers to them as
# os.environ/<NAME>; a model without its key fails when it is called. After a
# change, restart the proxy with `just launch`.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional settings, shown with their defaults.
# Host port of the LiteLLM proxy.
# LITELLM_PORT=4000
# Compose project of the proxy stack; stacks with different names (and ports)
# run side by side.
# COMPOSE_PROJECT_NAME=ssebench
# Registry prefix of every image SSEBench builds or pulls.
# SSEBENCH_REGISTRY=ghcr.io/42-b3yond-6ug/ssebench
