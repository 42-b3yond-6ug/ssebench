+func TestUnwrapIntent(t *testing.T) {
+	// Intent test: verify the developer's intended behaviour.
+	// Strings that do NOT have matching surrounding brackets/braces
+	// should be returned unchanged.
+	tests := []struct {
+		input    string
+		expected string
+	}{
+		{"{", "{"},   // single brace — no matching pair
+		{"[", "["},   // single bracket — no matching pair
+		{"{x", "{x"}, // starts with brace but no closing brace
+		{"[x", "[x"}, // starts with bracket but no closing bracket
+		{"x}", "x}"}, // ends with brace but doesn't start with one
+	}
+
+	for _, tt := range tests {
+		got := Unwrap(tt.input)
+		if got != tt.expected {
+			t.Errorf("Unwrap(%q) = %q, want %q", tt.input, got, tt.expected)
+		}
+	}
+}
