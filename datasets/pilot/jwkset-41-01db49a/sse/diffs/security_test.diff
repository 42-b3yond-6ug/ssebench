+func makeJWKS(kids []string) string {
+	var b strings.Builder
+	b.WriteString(`{"keys":[`)
+	for i, kid := range kids {
+		if i > 0 {
+			b.WriteString(",")
+		}
+		// kty=oct, k is base64url-encoded (here "QUFBQQ" = "AAAA")
+		b.WriteString(`{"kty":"oct","k":"QUFBQQ","kid":"`)
+		b.WriteString(kid)
+		b.WriteString(`"}`)
+	}
+	b.WriteString(`]}`)
+	return b.String()
+}
+
+func TestRefreshRevokedKeyNotReadableOnceNewKeysAppear(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+
+	// 1) Initially only "old" exists
+	oldJWKS := makeJWKS([]string{"old"})
+
+	// 2) After the switch, there are many new keys (excluding "old")
+	const n = 2000
+	newKids := make([]string, 0, n)
+	for i := 0; i < n; i++ {
+		newKids = append(newKids, "new-"+itoa(i))
+	}
+	newJWKS := makeJWKS(newKids)
+
+	var mu sync.Mutex
+	current := oldJWKS
+
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		body := current
+		mu.Unlock()
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(http.StatusOK)
+		_, _ = w.Write([]byte(body))
+	}))
+	defer srv.Close()
+
+	u, err := url.Parse(srv.URL)
+	if err != nil {
+		t.Fatalf("url.Parse: %v", err)
+	}
+
+	// Create storage and start background refresh
+	st, err := NewStorageFromHTTP(u, HTTPClientStorageOptions{
+		Client:             srv.Client(),
+		HTTPMethod:         http.MethodGet,
+		HTTPExpectedStatus: http.StatusOK,
+		Ctx:                ctx,
+		RefreshInterval:    10 * time.Millisecond,
+	})
+	if err != nil {
+		t.Fatalf("NewStorageFromHTTP: %v", err)
+	}
+
+	// Verify that "old" exists initially
+	if _, err := st.KeyRead(ctx, "old"); err != nil {
+		t.Fatalf("expected old to exist initially, got err: %v", err)
+	}
+
+	// Switch the remote JWKS: "old" is revoked
+	mu.Lock()
+	current = newJWKS
+	mu.Unlock()
+
+	// Wait until refresh starts writing new keys:
+	// we use "new-0 is readable" as the signal
+	deadline := time.Now().Add(6 * time.Second)
+	for {
+		if time.Now().After(deadline) {
+			t.Fatalf("timeout waiting for new-0 to appear (refresh may not be running)")
+		}
+		if _, err := st.KeyRead(ctx, "new-0"); err == nil {
+			break
+		}
+		time.Sleep(2 * time.Millisecond)
+	}
+
+	// 🔥 Critical assertion:
+	// once new keys start appearing, "old" must no longer be readable
+	//
+	// - Upstream fix: PASS (clear/delete first, then write new keys)
+	// - Your patch:   FAIL (write new keys first, then delete old at the end)
+	if _, err := st.KeyRead(ctx, "old"); err == nil {
+		t.Fatalf("FAIL: revoked key 'old' is still readable after new keys started appearing")
+	}
+}
+
+// A small helper: avoids importing fmt/Sprintf (keeps the test lightweight)
+func itoa(i int) string {
+	if i == 0 {
+		return "0"
+	}
+	var buf [32]byte
+	pos := len(buf)
+	for i > 0 {
+		pos--
+		buf[pos] = byte('0' + i%10)
+		i /= 10
+	}
+	return string(buf[pos:])
+}
