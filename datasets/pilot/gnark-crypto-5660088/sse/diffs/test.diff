+func TestRegressionQuoRem1483(t *testing.T) {
+	// Verify QuoRem satisfies the Euclidean property on the specific inputs
+	// from issue #1483. An incorrect QuoRem here is the root cause of the
+	// HalfGCD infinite loop.
+	a0, _ := new(big.Int).SetString("64502973549206556628585045361533709077", 10)
+	a1, _ := new(big.Int).SetString("-303414439467246543595250775667605759171", 10)
+	c0, _ := new(big.Int).SetString("-432420386565659656852420866390673177323", 10)
+	c1, _ := new(big.Int).SetString("238911465918039986966665730306072050094", 10)
+	x := ComplexNumber{A0: a0, A1: a1}
+	y := ComplexNumber{A0: c0, A1: c1}
+
+	var q, r ComplexNumber
+	q.QuoRem(&x, &y, &r)
+
+	// Check a == q*y + r
+	var check ComplexNumber
+	check.Mul(&y, &q)
+	check.Add(&check, &r)
+	if !check.Equal(&x) {
+		t.Fatalf("QuoRem identity failed: q*y + r != x")
+	}
+
+	// Check ||r|| < ||y|| (Euclidean property)
+	if r.Norm().Cmp(y.Norm()) >= 0 {
+		t.Fatalf("QuoRem Euclidean property violated: ||r||=%s >= ||y||=%s", r.Norm(), y.Norm())
+	}
+}
