{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A dataset's `dataset.yaml`, next to its task folders.",
  "properties": {
    "version": {
      "description": "Dataset version, such as pilot-v1.",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "version"
  ],
  "title": "SSEBench dataset info",
  "type": "object"
}
